# Redirect /index.html to /
RewriteEngine On

# Force HTTPS (301) - for shared hosting (heteml) where %{HTTPS} is always "off"
# behind a proxy. Also checks X-Forwarded-Proto to avoid redirect loops.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 例: https://example.com/index.html → https://example.com/
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Ensure directory index serves index.html
DirectoryIndex index.html

# Hide PHP version (X-Powered-By). "always" so it also applies to CGI responses.
<IfModule mod_headers.c>
  Header always unset X-Powered-By
</IfModule>
